# ===== 服务 =====
AGENT_PORT=8000
AGENT_HOST=127.0.0.1
NODE_API_URL=http://127.0.0.1:3000/api

# ===== LLM (Anthropic Claude) =====
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_FAST_MODEL=claude-haiku-3-5-20241022

# ===== LLM (DeepSeek — OpenAI 兼容) =====
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FAST_MODEL=deepseek-chat

# ===== 评测脚本可选 Provider（rag_eval/scripts 读取，仅跑多模型评测时需要） =====
# DASHSCOPE_API_KEY=sk-...   # 阿里云通义千问 DashScope
# QIANFAN_API_KEY=bce-v3/...  # 百度千帆

# ===== Embedding =====
EMBEDDING_MODEL=shibing624/text2vec-base-chinese
EMBEDDING_LOCAL_PATH=
HF_ENDPOINT=https://hf-mirror.com
SENTENCE_TRANSFORMERS_HOME=./models_cache

# ===== 向量库 =====
CHROMA_PERSIST_DIR=./chroma_db
CHUNK_SIZE=300
CHUNK_OVERLAP=50

# ===== 数据目录 =====
DATA_DIR=../excel_data

# ===== 安全 =====
AGENT_API_KEY=
RATE_LIMIT_PER_SECOND=2.0
RATE_LIMIT_BURST=5
MAX_INPUT_LENGTH=2000
MAX_OUTPUT_TOKENS=2000
