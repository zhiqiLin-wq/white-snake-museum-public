# ===== LLM Provider =====
LLM_PROVIDER=anthropic
# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_FAST_MODEL=claude-haiku-3-5-20241022
# DeepSeek (OpenAI 兼容)
# LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FAST_MODEL=deepseek-chat

# ===== Agent =====
AGENT_PORT=8000
AGENT_HOST=127.0.0.1
NODE_API_URL=http://127.0.0.1:3000/api

# ===== Embedding =====
EMBEDDING_MODEL=shibing624/text2vec-base-chinese
EMBEDDING_LOCAL_PATH=
HF_ENDPOINT=https://hf-mirror.com
SENTENCE_TRANSFORMERS_HOME=./models_cache

# ===== Data =====
CHROMA_PERSIST_DIR=./chroma_db
CHUNK_SIZE=300
CHUNK_OVERLAP=50
DATA_DIR=../excel_data
SQLITE_DB_PATH=./data/conversations.db

# ===== Security =====
AGENT_API_KEY=
RATE_LIMIT_PER_SECOND=10.0
RATE_LIMIT_BURST=20
MAX_INPUT_LENGTH=2000
MAX_OUTPUT_TOKENS=2000

# ===== Optional: Amap POI =====
AMAP_API_KEY=

# ===== Logging =====
LOG_LEVEL=DEBUG
